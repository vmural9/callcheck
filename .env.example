# AWS profile used for Bedrock (Nova Sonic, judge); never rely on a default profile.
AWS_PROFILE=
# AWS region for Bedrock calls.
AWS_REGION=us-west-2
# Nova Sonic model id used for the simulated caller and reference agent.
CALLCHECK_NOVA_SONIC_MODEL=amazon.nova-2-5-sonic
# Judge backend: bedrock (default) or fake. Targets (nova-sonic, fake) and callers (nova-sonic,
# fake) are chosen on the command line. More judges and adapters, with their API keys, arrive in
# later milestones.
CALLCHECK_JUDGE=bedrock
# Judge model id for the chosen backend.
CALLCHECK_JUDGE_MODEL=
# Directory where run folders are written.
CALLCHECK_RUNS_DIR=./runs
